# ---------------------------------------------------------------------------
# The Rock Factory Central — configuration
#
# On Vercel these are entered in the dashboard (Settings > Environment
# Variables), NOT in a file. This file documents what each one is.
# Leave a system's variables blank and the dashboard simply shows it as
# "not connected" rather than breaking.
# ---------------------------------------------------------------------------

# --- Google (Calendar + Gmail) ---------------------------------------------
# One Google sign-in covers both. Read-only access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Comma-separated calendar IDs holding client events.
# The Setup page lists every calendar the connected account can see, with its
# ID, so you can copy the right ones from there rather than hunting for them.
#   e.g. GOOGLE_EVENT_CALENDAR_IDS=abc123@group.calendar.google.com
GOOGLE_EVENT_CALENDAR_IDS=

# Per-crew-member calendars, as Name=calendarId, comma separated. Optional:
# used to show who is working when Connecteam is not connected.
#   e.g. GOOGLE_CREW_CALENDARS=Sam=abc123@group.calendar.google.com,Alex=def456@group.calendar.google.com
GOOGLE_CREW_CALENDARS=

# --- Streak ----------------------------------------------------------------
# Gmail > Streak > Integrations > API Key
STREAK_API_KEY=
# Found automatically and shown on the /setup page once the key works.
# `npm run verify:streak` also prints it.
STREAK_PIPELINE_KEY=

# Optional. How many boxes to pull per refresh, most recently active first.
# Default 400. The live Event Planning pipeline holds ~6,200 boxes (~60 MB of
# JSON), far too much to fetch on a dashboard load, so the connector asks for
# the newest N instead. At 400 that reaches roughly seven weeks back. Raise it
# if older live jobs go missing from the dashboard.
STREAK_BOX_LIMIT=

# --- Connecteam ------------------------------------------------------------
# Owner account > General Settings > API keys. Requires a higher-tier plan.
CONNECTEAM_API_KEY=
CONNECTEAM_SCHEDULER_ID=

# --- On Rent Events (runs on Current RMS) ----------------------------------
# The first part of your Current RMS web address.
# If you sign in at https://rockfactory.current-rms.com then this is "rockfactory".
ONRENT_SUBDOMAIN=

# Current RMS > System Setup > Integrations > API.
# WARNING: Current RMS API keys cannot be restricted to read-only — they grant
# full read AND write access to your rental system. This app only ever reads,
# but keep the key in a secret store and never in a file or a chat message.
ONRENT_API_KEY=

# Optional. Only set this if Current RMS tell you to use a different host.
# ONRENT_API_BASE=https://api.current-rms.com/api/v1

# --- Display ---------------------------------------------------------------
# Force sample data on ("true") or off ("false"). Default: sample data shows
# only while nothing at all is connected.
ROCK_FACTORY_SAMPLE_DATA=
